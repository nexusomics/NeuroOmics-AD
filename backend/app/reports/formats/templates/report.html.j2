<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ report.title }}</title>
<style>
  :root { --ink:#1c2b39; --accent:#0e7490; --muted:#64748b; --line:#e2e8f0; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
         color: var(--ink); margin:0; background:#f8fafc; line-height:1.6; }
  header { background: linear-gradient(135deg,#0f172a 0%, #134e4a 60%, #0e7490 100%);
           color:#fff; padding: 40px 24px 28px; }
  header h1 { margin: 0 0 6px; font-size: 26px; }
  header .sub { opacity:.85; font-size:14px; }
  main { max-width: 980px; margin: 0 auto; padding: 28px 20px 60px; }
  section { background:#fff; border:1px solid var(--line); border-radius:10px;
            padding: 20px 24px; margin-bottom: 20px; box-shadow:0 1px 2px rgba(15,23,42,.04);}
  h2 { font-size: 18px; margin: 0 0 12px; color:#134e4a; border-bottom:2px solid #ccfbf1; padding-bottom:6px; }
  h3 { font-size: 15px; margin: 14px 0 6px; color: var(--accent); }
  p { margin: 6px 0; }
  figure { margin: 14px 0; text-align:center; }
  figure img { max-width: 100%; border:1px solid var(--line); border-radius:8px; }
  figcaption { font-size: 12px; color: var(--muted); margin-top:6px; }
  .data-table { border-collapse: collapse; width: 100%; font-size: 12px; margin: 10px 0; }
  .data-table th { background:#0f172a; color:#fff; padding:6px 8px; text-align:left; }
  .data-table td { border-bottom:1px solid var(--line); padding:5px 8px; }
  .data-table tr:nth-child(even) td { background:#f1f5f9; }
  .meta { color: var(--muted); font-size: 12px; }
  ol.refs { font-size: 13px; color: #334155; }
  code { background:#f1f5f9; padding:1px 5px; border-radius:4px; font-size:12px; }
</style>
</head>
<body>
<header>
  <h1>{{ report.title }}</h1>
  {% if report.subtitle %}<div class="sub">{{ report.subtitle }}</div>{% endif %}
  <div class="meta" style="margin-top:10px;color:#cbd5e1;">
    Generated {{ report.generated_at }} · {{ report.tool_version }}
  </div>
</header>
<main>
  {% for section in report.sections %}
  <section>
    <h2>{{ section.title }}</h2>
    {% for para in section.paragraphs %}<p>{{ para }}</p>{% endfor %}
    {% for sub in section.subsections %}
      <h3>{{ sub.title }}</h3>
      {% for para in sub.paragraphs %}<p>{{ para }}</p>{% endfor %}
    {% endfor %}
  </section>
  {% endfor %}

  {% if figures %}
  <section>
    <h2>Figures</h2>
    {% for fig in figures %}
    <figure>
      {% if fig.b64 %}<img alt="{{ fig.name }}" src="data:image/{{ fig.ext }};base64,{{ fig.b64 }}"/>{% endif %}
      <figcaption><b>{{ fig.name }}</b>. {{ fig.caption }}</figcaption>
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  {% if tables %}
  <section>
    <h2>Tables</h2>
    {% for t in tables %}
    <h3>{{ t.name }}</h3>
    {% if t.caption %}<p class="meta">{{ t.caption }}</p>{% endif %}
    {{ t.html | safe }}
    {% endfor %}
  </section>
  {% endif %}

  {% if report.references %}
  <section>
    <h2>References</h2>
    <ol class="refs">{% for ref in report.references %}<li>{{ ref }}</li>{% endfor %}</ol>
  </section>
  {% endif %}

  <p class="meta" style="text-align:center;margin-top:24px;">Generated by {{ report.tool_version }} — for research use only.</p>
</main>
</body>
</html>
