# ==========================================================================
# NeuroOmics-AD environment configuration (copy to .env and edit)
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=NeuroOmics-AD
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated origins) ----------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database --------------------------------------------------------------
# Production: postgresql+psycopg://neuroomics:password@postgres:5432/neuroomics
# Development fallback when Postgres is unavailable: sqlite:///./neuroomics.db
DATABASE_URL=sqlite:///./neuroomics.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=neuroomics
POSTGRES_PASSWORD=neuroomics
POSTGRES_DB=neuroomics

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true to execute tasks synchronously (dev without Redis)
TASK_ALWAYS_EAGER=true

# --- Storage ----------------------------------------------------------------
# Local filesystem in dev; S3/MinIO-compatible in production
STORAGE_BACKEND=local             # local | s3
STORAGE_ROOT=./media
S3_ENDPOINT_URL=
S3_BUCKET=neuroomics
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- ML ---------------------------------------------------------------------
ML_CACHE_DIR=./.mlcache
GNN_HIDDEN_DIM=64
GNN_EPOCHS=50
RANDOM_SEED=42

# --- Drug repurposing --------------------------------------------------------
DRUG_API_TIMEOUT=10
DRUG_ENABLE_LIVE_API=false        # set true to hit ChEMBL / Open Targets / DGIdb live
DRUG_DATABANK_XML_PATH=           # optional DrugBank full database XML
CLINICALTRIALS_API_KEY=           # optional: https://clinicaltrials.gov/api/v2 (no key needed)

# --- AI Research Assistant ---------------------------------------------------
ASSISTANT_MODE=local              # local | llm
ASSISTANT_API_BASE=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.4

# --- Default admin (created on first startup) ---
ADMIN_EMAIL=admin@neuroomics.org
ADMIN_PASSWORD=admin12345
